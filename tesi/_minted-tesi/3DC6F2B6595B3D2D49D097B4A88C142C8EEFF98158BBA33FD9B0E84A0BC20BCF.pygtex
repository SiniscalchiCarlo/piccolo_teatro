      \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{\PYGZus{}\PYGZus{}update\PYGZus{}percentage\PYGZus{}sales\PYGZus{}day}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
        \PYG{c+c1}{\PYGZsh{} Extract the last row of the existing DataFrame}
        \PYG{n}{last\PYGZus{}row} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{df}\PYG{o}{.}\PYG{n}{iloc}\PYG{p}{[[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]]}
        \PYG{c+c1}{\PYGZsh{} Increment the days since sales start}
        \PYG{n}{increased\PYGZus{}day} \PYG{o}{=} \PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{last\PYGZus{}row}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}start\PYGZus{}sales\PYGZus{}distance\PYGZdq{}}\PYG{p}{]}\PYG{o}{.}\PYG{n}{iloc}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{])} \PYG{o}{+} \PYG{l+m+mi}{1}
